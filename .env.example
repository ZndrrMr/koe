# Koe client environment
# Copy to .env.local and fill in. Only EXPO_PUBLIC_* vars are shipped to the client bundle.
EXPO_PUBLIC_WORKER_URL=https://koe-worker.your-subdomain.workers.dev

# Debug-only recorded conversation input (MP3, M4A, or WAV).
# EXPO_PUBLIC_KOE_INJECT_AUDIO_URI=http://127.0.0.1:8790/canonical.wav
# Pipe-separated development sequence; each URL must end in its real filename.
# EXPO_PUBLIC_KOE_INJECT_AUDIO_URIS=http://127.0.0.1:8790/short.mp3|http://127.0.0.1:8790/long.mp3
# EXPO_PUBLIC_KOE_INJECT_AUDIO_FILENAME=canonical.wav
# EXPO_PUBLIC_KOE_INJECT_AUDIO_MIME_TYPE=audio/wav

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
